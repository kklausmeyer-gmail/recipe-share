{
  "name": "recipe-share",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "import:heic": "tsx scripts/convert-heic.ts",
    "import:links": "tsx scripts/extract-links.ts",
    "import:review": "tsx scripts/review.ts",
    "import:upload": "tsx --env-file=.env.local scripts/upload.ts",
    "queue:pull": "tsx --env-file=.env.local scripts/queue.ts pull",
    "queue:push": "tsx --env-file=.env.local scripts/queue.ts push"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^0.447.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "heic-convert": "^2.1.0",
    "postcss": "^8.4.47",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.1"
  }
}
